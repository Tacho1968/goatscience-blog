---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/literata';
import '@fontsource-variable/literata/wght-italic.css';
import '../styles/global.css';
import { SITE, ROUTES, type Lang } from '../config';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altUrl?: string; // misma página en el otro idioma
}
const { lang, title, description, altUrl } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}: ${s.tagline}`;
const desc = description ?? s.description;
const path = Astro.url.pathname;
const switchUrl = altUrl ?? `/${other}/`;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(switchUrl, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} (${s.langName})`} href={`/${lang}/rss.xml`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-head">
      <div class="wrap bar">
        <a class="mark" href={`/${lang}/`} aria-label={SITE.title}>
          <span>Goat Science</span>
        </a>
        <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <a href={ROUTES.archive[lang]} aria-current={path === ROUTES.archive[lang] ? 'page' : undefined}>{s.nav.archive}</a>
          <a href={ROUTES.about[lang]} aria-current={path === ROUTES.about[lang] ? 'page' : undefined}>{s.nav.about}</a>
          <a href="#suscribir">{s.nav.subscribe}</a>
          <a class="lang" href={switchUrl} hreflang={other} lang={other}>{s.switchTo}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot">
        <p class="who">{SITE.author}. {s.authorRole}.</p>
        <p class="disc">{s.disclaimer}</p>
        <p class="links">
          <a href={`/${lang}/rss.xml`}>{s.rss}</a>
          <a href={ROUTES.privacy[lang]}>{s.subPrivacy[0].toUpperCase() + s.subPrivacy.slice(1)}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5rem 0.75rem;
    background: var(--green);
    color: var(--bg);
    z-index: 10;
  }
  .site-head {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    color: var(--green);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--step--1);
  }
  nav a {
    text-decoration: none;
    color: var(--ink);
    padding-block: 0.25rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--green);
    box-shadow: inset 0 -2px 0 var(--ochre-bright);
  }
  nav .lang {
    color: var(--muted);
  }
  .site-foot {
    margin-top: 0;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .foot {
    padding-block: 2rem 3rem;
    display: grid;
    gap: 0.5rem;
  }
  .foot p {
    margin: 0;
    max-width: 60ch;
  }
  .who {
    color: var(--ink);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.5rem !important;
  }
  .links a {
    color: var(--muted);
  }
</style>
