---
import Base from '../layouts/Base.astro';
import Subscribe from './Subscribe.astro';
import IssueList from './IssueList.astro';
import { ROUTES, type Lang } from '../config';
import { t, dateFmt } from '../i18n';
import { postsFor, urlOf } from '../lib/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const posts = await postsFor(lang);
const [latest, ...rest] = posts;
const other: Lang = lang === 'es' ? 'en' : 'es';
---

<Base lang={lang} altUrl={`/${other}/`}>
  <section class="wrap intro">
    <p class="tag">{s.tagline}</p>
  </section>

  {
    latest ? (
      <article class="wrap latest" aria-labelledby="latest-h">
        <div class="num" aria-hidden="true">
          <span class="lbl">{s.issue}</span>
          <span class="big">{latest.data.numero}</span>
        </div>
        <div class="txt">
          <p class="when">
            {s.latest}, <time datetime={latest.data.fecha.toISOString()}>{dateFmt(latest.data.fecha, lang)}</time>
          </p>
          <h1 id="latest-h">
            <a href={urlOf(latest)}>{latest.data.titulo}</a>
          </h1>
          <p class="idea">{latest.data.idea}</p>
          <p class="ref">
            {latest.data.articulo.autores} ({latest.data.articulo.anio}). <cite>{latest.data.articulo.titulo}</cite>.{' '}
            <em>{latest.data.articulo.revista}</em>.
          </p>
          <a class="cta" href={urlOf(latest)}>
            {s.read}
          </a>
        </div>
      </article>
    ) : (
      <section class="wrap empty">
        <h1>Goat Science</h1>
        <p>{s.empty}</p>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="wrap prev" aria-labelledby="prev-h">
        <h2 id="prev-h">{s.previous}</h2>
        <IssueList lang={lang} posts={rest.slice(0, 6)} />
        {rest.length > 6 && (
          <p class="all">
            <a href={ROUTES.archive[lang]}>{s.allIssues}</a>
          </p>
        )}
      </section>
    )
  }

  <Subscribe lang={lang} />
</Base>

<style>
  .intro {
    padding-top: 2.5rem;
  }
  .tag {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 40ch;
  }
  .latest {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 3rem;
    padding-block: 1.5rem 1rem;
  }
  @media (min-width: 52rem) {
    .latest {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      padding-top: 3rem;
    }
  }
  .num {
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    font-family: var(--font-head);
    color: var(--ochre-bright);
    line-height: 0.8;
  }
  .lbl {
    font-weight: 700;
    font-size: var(--step-2);
    padding-top: 0.6rem;
  }
  .big {
    font-weight: 800;
    font-size: var(--step-5);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .txt {
    max-width: 44rem;
  }
  .when {
    margin: 0 0 0.75rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  h1 a {
    color: inherit;
    text-decoration: none;
  }
  h1 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ochre-bright);
    text-decoration-thickness: 3px;
  }
  .idea {
    font-size: var(--step-1);
    line-height: 1.5;
    margin: 1.25rem 0 1rem;
    max-width: 52ch;
  }
  .ref {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0 0 1.75rem;
    max-width: 70ch;
  }
  .ref cite {
    font-style: normal;
  }
  .cta {
    display: inline-block;
    font-family: var(--font-head);
    font-weight: 700;
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    border-radius: 6px;
    background: var(--green);
    color: var(--bg);
  }
  .cta:hover {
    filter: brightness(1.15);
  }
  .prev {
    margin-top: 4.5rem;
  }
  .prev h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .all {
    margin-top: 1.25rem;
  }
  .empty {
    padding-block: 4rem;
  }
  .empty h1 {
    margin-bottom: 1rem;
  }
</style>
