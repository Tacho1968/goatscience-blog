---
import { SUBSCRIBE_EMAIL, ROUTES, type Lang } from '../config';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const id = `sub-${lang}`;

const mailto = (subject: string, body: string) =>
  `mailto:${SUBSCRIBE_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
const subscribeHref = mailto(s.subMailSubject, s.subMailBody);
const unsubscribeHref = mailto(s.unsubMailSubject, s.unsubMailBody);
---

<section class="sub" id="suscribir" aria-labelledby={`${id}-h`}>
  <div class="wrap inner">
    <div class="copy">
      <h2 id={`${id}-h`}>{s.subTitle}</h2>
      <p>{s.subText}</p>
    </div>

    <div class="how">
      <p>
        {s.subHow} <a href={subscribeHref}>{SUBSCRIBE_EMAIL}</a>{' '}{s.subHow2}
      </p>
      <ul>
        {s.subFields.map((f) => <li>{f}</li>)}
      </ul>
      <a class="btn" href={subscribeHref}>{s.subButton}</a>
      <p class="small">
        {s.unsubText} <a href={unsubscribeHref}>{s.unsubLink}</a>. {s.subPrivacyPre}{' '}
        <a href={ROUTES.privacy[lang]}>{s.subPrivacy}</a>.
      </p>
      <p class="small">
        <a href={`/${lang}/rss.xml`}>{s.rss}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .sub {
    --on: #eef1ea;
    background: #1e3a2b;
    color: var(--on);
    margin-top: 5rem;
  }
  .inner {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: 3rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  h2 {
    color: var(--on);
    font-size: var(--step-3);
  }
  .copy p {
    margin: 0.75rem 0 0;
    max-width: 44ch;
    opacity: 0.85;
  }
  .how p {
    margin: 0 0 0.5rem;
    max-width: 48ch;
  }
  .how ul {
    margin: 0 0 1.25rem;
    padding-left: 1.2rem;
  }
  .how li + li {
    margin-top: 0.2rem;
  }
  .btn {
    display: inline-block;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-0);
    padding: 0.8rem 1.4rem;
    border-radius: 6px;
    background: #d9ad4a;
    color: #17211c !important;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .btn:hover {
    filter: brightness(1.08);
  }
  .small {
    font-size: var(--step--1);
    opacity: 0.85;
  }
  .sub a {
    color: var(--on);
    overflow-wrap: anywhere;
  }
</style>
